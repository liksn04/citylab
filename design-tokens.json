{
  "$schema": "./docs/design-tokens.schema-note",
  "meta": {
    "name": "Neural City Analytical Glass",
    "theme": "dark",
    "version": "1.0.0"
  },
  "color": {
    "ink-0": "#070a0e",
    "ink-50": "#0b0f14",
    "ink-100": "#10161d",
    "ink-150": "#151d26",
    "ink-200": "#1b2530",
    "text-1": "#f4f7fa",
    "text-2": "#bec7d1",
    "text-3": "#8d98a5",
    "teal-400": "#62d6c8",
    "amber-400": "#efb45d",
    "red-400": "#f06f72",
    "sky-400": "#80b7f4"
  },
  "glass": {
    "glass-thin-bg": "rgb(16 22 29 / 0.58)",
    "glass-regular-bg": "rgb(18 25 33 / 0.72)",
    "glass-thick-bg": "rgb(20 27 36 / 0.88)",
    "glass-border": "rgb(255 255 255 / 0.09)",
    "glass-highlight": "rgb(255 255 255 / 0.055)",
    "blur-thin": "10px",
    "blur-regular": "18px",
    "blur-thick": "28px"
  },
  "radius": {
    "radius-xs": "6px",
    "radius-sm": "10px",
    "radius-md": "14px",
    "radius-lg": "18px",
    "radius-shell": "20px",
    "radius-pill": "9999px"
  },
  "spacing": {
    "space-1": "2px",
    "space-2": "4px",
    "space-3": "8px",
    "space-4": "12px",
    "space-5": "16px",
    "space-6": "20px",
    "space-7": "24px",
    "space-8": "32px",
    "space-9": "40px",
    "space-10": "48px",
    "space-11": "64px"
  },
  "motion": {
    "motion-fast": "120ms",
    "motion-base": "180ms",
    "motion-slow": "260ms",
    "ease-standard": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
